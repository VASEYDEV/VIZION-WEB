index 0000000..99dde1c
--- /dev/null
+++ b/src/lib/security/bearer.ts
@@ -0,0 +1,15 @@
+/**
+ * Native-client session transport (VIZION for iOS).
+ *
+ * The web app's session travels as Supabase cookies (@supabase/ssr). A native
+ * app holds its own Supabase session (supabase-swift, Keychain) and presents
+ * the access token as `Authorization: Bearer <jwt>` instead. This is the ONE
+ * place that header is read; `createClient()` verifies the token against
+ * Supabase Auth before any route sees a user, so nothing here is trusted on
+ * its own.
+ */
+export function bearerToken(header: string | null | undefined): string | null {
+  if (!header) return null;
+  const match = /^Bearer\s+([A-Za-z0-9\-._~+/]+=*)$/i.exec(header.trim());
+  return match?.[1] ?? null;
+}
