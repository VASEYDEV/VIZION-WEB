+
+/**
+ * Native-app session: the token is VERIFIED before it is trusted. `setSession`
+ * on an unexpired access token calls `/auth/v1/user` with it — a forged or
+ * revoked token fails there and no session is stored, so every subsequent
+ * `auth.getUser()` in the route answers null and the route 401s exactly as it
+ * would for a missing cookie. The sentinel refresh token means an EXPIRED
+ * token can never be refreshed here (the native client refreshes its own
+ * tokens before calling); it fails closed the same way.
+ *
+ * `persistSession: false` + no cookie adapter: nothing is written to the
+ * response. The `global` header keeps PostgREST/Storage calls on the same JWT.
+ */
+async function createNativeClient(
+  accessToken: string,
+): Promise<SupabaseClient<Database>> {
+  const supabase = createSupabaseClient<Database>(
+    process.env.NEXT_PUBLIC_SUPABASE_URL!,
+    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!,
+    {
+      auth: { persistSession: false, autoRefreshToken: false, detectSessionInUrl: false },
+      global: { headers: { Authorization: `Bearer ${accessToken}` } },
+    },
+  );
+  try {
+    await supabase.auth.setSession({
+      access_token: accessToken,
+      refresh_token: "native",
+    });
+  } catch {
+    // Invalid/expired token — leave the client session-less; getUser() → null.
+  }
+  return supabase;
+}
diff --git a/tests/unit/account-route.test.ts b/tests/unit/account-route.test.ts
new file mode 100644
index 0000000..8316f4f
--- /dev/null
+++ b/tests/unit/account-route.test.ts
@@ -0,0 +1,84 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+/**
+ * DELETE /api/account — the native app's deletion path. Mirrors the
+ * delete-account route's invariants over a JSON/status transport: session
+ * gate first, fail closed without the service-role key, and only the verified
+ * session's user id ever reaches an admin call.
+ */
+const supabaseMock = vi.hoisted(() => ({
+  auth: { getUser: vi.fn(async () => ({ data: { user: { id: "u1" } } })) },
+}));
+vi.mock("@/lib/supabase/server", () => ({
+  createClient: vi.fn(async () => supabaseMock),
+}));
+const storeMock = vi.hoisted(() => ({
+  list: vi.fn(async () => ({ data: [{ name: "asset.png" }], error: null })),
+  remove: vi.fn<(paths: string[]) => Promise<{ error: { message: string } | null }>>(
+    async () => ({ error: null }),
+  ),
+}));
+const adminMock = vi.hoisted(() => ({
+  storage: { from: vi.fn(() => storeMock) },
+  auth: { admin: { deleteUser: vi.fn(async () => ({ error: null })) } },
+}));
+const adminFactory = vi.hoisted(() => ({
+  createAdminClient: vi.fn((): unknown => adminMock),
+}));
+vi.mock("@/lib/supabase/admin", () => adminFactory);
+
+import { DELETE } from "@/app/api/account/route";
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.spyOn(console, "error").mockImplementation(() => {});
+  supabaseMock.auth.getUser.mockResolvedValue({ data: { user: { id: "u1" } } });
+  adminFactory.createAdminClient.mockReturnValue(adminMock);
+  storeMock.list.mockResolvedValue({ data: [{ name: "asset.png" }], error: null });
+});
+
+describe("DELETE /api/account", () => {
+  it("401s without a verified session — before any admin work", async () => {
+    supabaseMock.auth.getUser.mockResolvedValue({ data: { user: null } } as never);
+    const res = await DELETE();
+    expect(res.status).toBe(401);
+    expect(adminFactory.createAdminClient).not.toHaveBeenCalled();
+  });
+
+  it("503s (nothing deleted) when the service-role key is absent", async () => {
+    adminFactory.createAdminClient.mockReturnValue(null);
+    const res = await DELETE();
+    expect(res.status).toBe(503);
+    expect(adminMock.auth.admin.deleteUser).not.toHaveBeenCalled();
+  });
+
+  it("purges media, the avatar, then the auth user, and answers 204", async () => {
+    const res = await DELETE();
+    expect(res.status).toBe(204);
+    expect(storeMock.list).toHaveBeenCalledWith("u1", { limit: 100 });
+    expect(storeMock.remove).toHaveBeenCalledWith(["u1/asset.png"]);
+    expect(storeMock.remove).toHaveBeenCalledWith(["u1/avatar.png"]);
+    expect(adminMock.auth.admin.deleteUser).toHaveBeenCalledWith("u1");
+  });
+
+  it("500s and stops at the first failing step", async () => {
+    storeMock.list.mockResolvedValue({ data: null, error: { message: "boom" } } as never);
+    const res = await DELETE();
+    expect(res.status).toBe(500);
+    expect(adminMock.auth.admin.deleteUser).not.toHaveBeenCalled();
+  });
+
+  it("500s when the avatar removal reports an error — the auth user survives", async () => {
+    // A fresh user id: the route's limiter is keyed per user and the cases
+    // above have already spent u1's budget.
+    supabaseMock.auth.getUser.mockResolvedValue({ data: { user: { id: "u2" } } });
+    storeMock.remove.mockImplementation(async (paths: string[]) =>
+      paths[0]?.endsWith("/avatar.png")
+        ? { error: { message: "boom" } }
+        : { error: null },
+    );
+    const res = await DELETE();
+    expect(res.status).toBe(500);
+    expect(adminMock.auth.admin.deleteUser).not.toHaveBeenCalled();
+  });
+});
