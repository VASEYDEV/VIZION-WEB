+++ b/src/app/api/account/route.ts
@@ -0,0 +1,65 @@
+import { NextResponse } from "next/server";
+import { createClient } from "@/lib/supabase/server";
+import { createAdminClient } from "@/lib/supabase/admin";
+import { purgeAccount } from "@/lib/auth/delete-account";
+import { rateLimit } from "@/lib/security/rate-limit";
+
+/**
+ * Account deletion for the native app (App Store Review Guideline 5.1.1(v):
+ * an app that lets people create an account must let them delete it in-app).
+ *
+ * The JSON/status twin of the web `/auth/delete-account` form POST: same
+ * session gate, same fail-closed posture when the service-role key is absent,
+ * same `purgeAccount` — only the transport differs. The session arrives as a
+ * Bearer token (src/lib/security/bearer.ts), verified by createClient().
+ *
+ *   204  deleted (the app signs out locally)
+ *   401  no verified session
+ *   429  more than three attempts in an hour
+ *   503  SUPABASE_SERVICE_ROLE_KEY not configured — nothing deleted
+ *   500  a storage or auth step failed — nothing further deleted
+ */
+export async function DELETE() {
+  const supabase = await createClient();
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+  if (!user)
+    return NextResponse.json(
+      { error: "Sign in to delete your account." },
+      { status: 401 },
+    );
+
+  if (!rateLimit(`delete-account:${user.id}`, 3, 3_600_000).allowed) {
+    return NextResponse.json(
+      { error: "Too many attempts — try again later." },
+      { status: 429 },
+    );
+  }
+
+  const admin = createAdminClient();
+  if (!admin) {
+    console.error("[api/account] SUPABASE_SERVICE_ROLE_KEY is not configured");
+    return NextResponse.json(
+      {
+        error:
+          "Account deletion isn't configured on the server yet — nothing was deleted.",
+      },
+      { status: 503 },
+    );
+  }
+
+  try {
+    await purgeAccount(admin, user.id);
+  } catch (e) {
+    console.error("[api/account] failed:", e instanceof Error ? e.message : e);
+    return NextResponse.json(
+      {
+        error:
+          "Something went wrong — nothing was deleted. Try again or contact support.",
+      },
+      { status: 500 },
+    );
+  }
+  return new NextResponse(null, { status: 204 });
+}
