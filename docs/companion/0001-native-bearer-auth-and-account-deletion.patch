diff --git a/src/lib/auth/delete-account.ts b/src/lib/auth/delete-account.ts
new file mode 100644
index 0000000..fb1c076
--- /dev/null
+++ b/src/lib/auth/delete-account.ts
@@ -0,0 +1,45 @@
+import "server-only";
+import type { createAdminClient } from "@/lib/supabase/admin";
+
+type Admin = NonNullable<ReturnType<typeof createAdminClient>>;
+
+/**
+ * Remove everything an account owns, then the account (shared by the web
+ * `/auth/delete-account` POST and the native `DELETE /api/account`).
+ *
+ * Privilege containment: the ONLY identifier that reaches an admin call is the
+ * `userId` the caller took from a verified session — both callers check the
+ * session before constructing the admin client.
+ *
+ * Deletion order: storage objects first (they do NOT cascade), then the auth
+ * user. Every public user-keyed table carries FK → auth.users ON DELETE
+ * CASCADE — verified live via pg_constraint on 2026-07-27 — so
+ * `auth.admin.deleteUser` removes all rows in one step. Throws on any failure;
+ * callers decide the response shape.
+ */
+export async function purgeAccount(admin: Admin, userId: string): Promise<void> {
+  // Media originals: {user_id}/<uuid>.<ext> — paginate the listing so a
+  // large library can't strand objects past the first page.
+  const mediaStore = admin.storage.from("media");
+  for (;;) {
+    const { data: objects, error } = await mediaStore.list(userId, { limit: 100 });
+    if (error) throw new Error(`media list failed: ${error.message}`);
+    if (!objects || objects.length === 0) break;
+    const paths = objects.map((o) => `${userId}/${o.name}`);
+    const { error: rmErr } = await mediaStore.remove(paths);
+    if (rmErr) throw new Error(`media remove failed: ${rmErr.message}`);
+    if (objects.length < 100) break;
+  }
+  // Avatar lives at a fixed path; a missing object is not an error (Storage
+  // answers success for absent keys) — but a failed request must stop the
+  // deletion: a public avatar with no owner left to authenticate could never
+  // be removed again.
+  const { error: avatarErr } = await admin.storage
+    .from("avatars")
+    .remove([`${userId}/avatar.png`]);
+  if (avatarErr) throw new Error(`avatar remove failed: ${avatarErr.message}`);
+
+  // Cascades every public row keyed to this user and ends the account itself.
+  const { error: authErr } = await admin.auth.admin.deleteUser(userId);
+  if (authErr) throw new Error(`auth delete failed: ${authErr.message}`);
+}
