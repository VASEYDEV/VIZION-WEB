diff --git a/tests/unit/delete-account.test.ts b/tests/unit/delete-account.test.ts
new file mode 100644
index 0000000..9171524
--- /dev/null
+++ b/tests/unit/delete-account.test.ts
@@ -0,0 +1,109 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+/**
+ * purgeAccount with Sign in with Apple in the picture: the Apple token is
+ * revoked FIRST (Guideline 5.1.1(v)); a failed revoke stops the deletion
+ * while there is still a row to retry from; a missing APPLE_* config is
+ * logged and the deletion goes ahead.
+ */
+const appleMock = vi.hoisted(() => ({
+  appleConfig: vi.fn((): unknown => ({
+    teamId: "T",
+    keyId: "K",
+    clientId: "ai.vasey.vizion",
+    privateKey: "pem",
+  })),
+  revokeAppleToken: vi.fn(async () => {}),
+}));
+vi.mock("@/lib/auth/apple", () => appleMock);
+
+type TokenRead = Promise<{
+  data: { refresh_token: string } | null;
+  error: { message: string } | null;
+}>;
+const tokenRow = vi.hoisted(() => ({
+  maybeSingle: vi.fn((): TokenRead => Promise.resolve({ data: null, error: null })),
+}));
+const storeMock = vi.hoisted(() => ({
+  list: vi.fn(async () => ({ data: [{ name: "asset.png" }], error: null })),
+  remove: vi.fn(async () => ({ error: null })),
+}));
+const adminMock = vi.hoisted(() => ({
+  from: vi.fn(() => ({ select: vi.fn(() => ({ eq: vi.fn(() => tokenRow) })) })),
+  storage: { from: vi.fn(() => storeMock) },
+  auth: { admin: { deleteUser: vi.fn(async () => ({ error: null })) } },
+}));
+
+import { purgeAccount } from "@/lib/auth/delete-account";
+
+const admin = adminMock as unknown as Parameters<typeof purgeAccount>[0];
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.spyOn(console, "error").mockImplementation(() => {});
+  tokenRow.maybeSingle.mockResolvedValue({ data: null, error: null });
+  appleMock.appleConfig.mockReturnValue({
+    teamId: "T",
+    keyId: "K",
+    clientId: "ai.vasey.vizion",
+    privateKey: "pem",
+  });
+  appleMock.revokeAppleToken.mockResolvedValue(undefined);
+});
+
+describe("purgeAccount — Sign in with Apple", () => {
+  it("does nothing Apple-related for an account without a token row", async () => {
+    await purgeAccount(admin, "u1");
+    expect(adminMock.from).toHaveBeenCalledWith("apple_refresh_tokens");
+    expect(appleMock.revokeAppleToken).not.toHaveBeenCalled();
+    expect(adminMock.auth.admin.deleteUser).toHaveBeenCalledWith("u1");
+  });
+
+  it("revokes the token before storage or the auth user are touched", async () => {
+    tokenRow.maybeSingle.mockResolvedValue({
+      data: { refresh_token: "r1" },
+      error: null,
+    });
+    await purgeAccount(admin, "u1");
+    expect(appleMock.revokeAppleToken).toHaveBeenCalledWith(
+      expect.objectContaining({ clientId: "ai.vasey.vizion" }),
+      "r1",
+    );
+    const revokedAt = appleMock.revokeAppleToken.mock.invocationCallOrder[0]!;
+    expect(storeMock.remove.mock.invocationCallOrder[0]).toBeGreaterThan(revokedAt);
+    expect(adminMock.auth.admin.deleteUser.mock.invocationCallOrder[0]).toBeGreaterThan(
+      revokedAt,
+    );
+  });
+
+  it("stops before deleting anything when the revoke fails", async () => {
+    tokenRow.maybeSingle.mockResolvedValue({
+      data: { refresh_token: "r1" },
+      error: null,
+    });
+    appleMock.revokeAppleToken.mockRejectedValue(new Error("apple token revoke failed"));
+    await expect(purgeAccount(admin, "u1")).rejects.toThrow("revoke failed");
+    expect(storeMock.remove).not.toHaveBeenCalled();
+    expect(adminMock.auth.admin.deleteUser).not.toHaveBeenCalled();
+  });
+
+  it("stops when the token row cannot be read", async () => {
+    tokenRow.maybeSingle.mockResolvedValue({ data: null, error: { message: "down" } });
+    await expect(purgeAccount(admin, "u1")).rejects.toThrow("apple token read failed");
+    expect(adminMock.auth.admin.deleteUser).not.toHaveBeenCalled();
+  });
+
+  it("deletes anyway, with a logged error, when APPLE_* is not configured", async () => {
+    tokenRow.maybeSingle.mockResolvedValue({
+      data: { refresh_token: "r1" },
+      error: null,
+    });
+    appleMock.appleConfig.mockReturnValue(null);
+    await purgeAccount(admin, "u1");
+    expect(appleMock.revokeAppleToken).not.toHaveBeenCalled();
+    expect(console.error).toHaveBeenCalledWith(
+      expect.stringContaining("APPLE_* not configured"),
+    );
+    expect(adminMock.auth.admin.deleteUser).toHaveBeenCalledWith("u1");
+  });
+});
