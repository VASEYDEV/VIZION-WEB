diff --git a/supabase/migrations/20260904190100_apple_sign_in.sql b/supabase/migrations/20260904190100_apple_sign_in.sql
new file mode 100644
index 0000000..95d64d9
--- /dev/null
+++ b/supabase/migrations/20260904190100_apple_sign_in.sql
@@ -0,0 +1,83 @@
+-- Sign in with Apple (native iOS app, vizion-web ADR-0006).
+-- 2/2: file Apple accounts under 'apple' (they were falling into the
+-- magic_link branch and its set-password gate), and keep the Apple refresh
+-- token per user so account deletion can revoke it — Apple requires apps
+-- that offer Sign in with Apple to revoke the user's tokens on deletion
+-- (App Store Review Guideline 5.1.1(v)).
+
+create or replace function public.handle_new_user()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_provider text := new.raw_app_meta_data ->> 'provider';
+  v_auth_method public.auth_method;
+begin
+  v_auth_method := case
+    when v_provider = 'github' then 'github'::public.auth_method
+    when v_provider = 'google' then 'google'::public.auth_method
+    when v_provider = 'apple' then 'apple'::public.auth_method
+    else 'magic_link'::public.auth_method
+  end;
+
+  insert into public.profiles (user_id, email, full_name, avatar_url, auth_method)
+  values (
+    new.id,
+    new.email,
+    coalesce(new.raw_user_meta_data ->> 'full_name', new.raw_user_meta_data ->> 'name'),
+    new.raw_user_meta_data ->> 'avatar_url',
+    v_auth_method
+  )
+  on conflict (user_id) do nothing;
+
+  if v_provider in ('github', 'google') then
+    insert into public.oauth_identities (user_id, provider, provider_uid, raw_profile)
+    values (
+      new.id,
+      v_provider::public.oauth_provider,
+      coalesce(
+        new.raw_user_meta_data ->> 'provider_id',
+        new.raw_user_meta_data ->> 'sub',
+        new.id::text
+      ),
+      new.raw_user_meta_data
+    )
+    on conflict (provider, provider_uid) do nothing;
+  end if;
+
+  return new;
+end;
+$$;
+
+-- Apple refresh tokens: the app stores its own (POST /api/auth/apple, user
+-- session, own row only); purgeAccount reads and revokes with the service
+-- role. Never useful to anyone else: Apple accepts the token only together
+-- with the team's client secret.
+create table public.apple_refresh_tokens (
+  user_id       uuid primary key references auth.users (id) on delete cascade,
+  refresh_token text not null,
+  updated_at    timestamptz not null default now()
+);
+
+comment on table public.apple_refresh_tokens is
+  'Sign in with Apple refresh token per user; revoked on account deletion (owner writes, service role revokes).';
+
+alter table public.apple_refresh_tokens enable row level security;
+
+create policy "apple_refresh_tokens_select_own"
+  on public.apple_refresh_tokens for select
+  using (auth.uid() = user_id);
+
+create policy "apple_refresh_tokens_insert_own"
+  on public.apple_refresh_tokens for insert
+  with check (auth.uid() = user_id);
+
+create policy "apple_refresh_tokens_update_own"
+  on public.apple_refresh_tokens for update
+  using (auth.uid() = user_id)
+  with check (auth.uid() = user_id);
+
+revoke all on table public.apple_refresh_tokens from anon;
+grant select, insert, update on table public.apple_refresh_tokens to authenticated;
