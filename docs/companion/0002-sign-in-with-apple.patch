diff --git a/src/lib/auth/apple.ts b/src/lib/auth/apple.ts
new file mode 100644
index 0000000..dcc0684
--- /dev/null
+++ b/src/lib/auth/apple.ts
@@ -0,0 +1,147 @@
+import "server-only";
+import { createPrivateKey, sign } from "node:crypto";
+
+/**
+ * Sign in with Apple, server side (vizion-web ADR-0006).
+ *
+ * The native app signs in with Apple's identity token straight against
+ * Supabase; nothing here is on that path. This module exists for the one
+ * thing Supabase does not do: Apple requires an app that offers Sign in with
+ * Apple to REVOKE the user's tokens when the account is deleted (App Store
+ * Review Guideline 5.1.1(v)). Revocation needs a refresh token, and the only
+ * way to get one is to exchange the single-use authorization code the app
+ * received at sign-in — so `POST /api/auth/apple` exchanges and stores it,
+ * and `purgeAccount` revokes it.
+ *
+ * Both calls authenticate to Apple with a client secret: an ES256 JWT signed
+ * by the team's Sign in with Apple key (.p8). Minted per call, five minutes
+ * long — the six-month maximum Apple allows is for pre-generated secrets.
+ */
+
+const APPLE_TOKEN_URL = "https://appleid.apple.com/auth/token";
+const APPLE_REVOKE_URL = "https://appleid.apple.com/auth/revoke";
+const APPLE_AUDIENCE = "https://appleid.apple.com";
+
+export interface AppleConfig {
+  /** Apple Developer Team ID (10 characters). */
+  teamId: string;
+  /** Key ID of the Sign in with Apple key. */
+  keyId: string;
+  /** The iOS app's bundle id — the client id of the native flow. */
+  clientId: string;
+  /** The .p8 contents (PKCS#8 PEM). `\n` escapes are accepted for env storage. */
+  privateKey: string;
+}
+
+/**
+ * APPLE_TEAM_ID · APPLE_KEY_ID · APPLE_CLIENT_ID · APPLE_PRIVATE_KEY. Null when
+ * any is missing: callers then skip Apple (the sign-in itself never depends
+ * on this — only the revocation bookkeeping does).
+ */
+export function appleConfig(
+  env: Record<string, string | undefined> = process.env,
+): AppleConfig | null {
+  const teamId = env.APPLE_TEAM_ID?.trim();
+  const keyId = env.APPLE_KEY_ID?.trim();
+  const clientId = env.APPLE_CLIENT_ID?.trim();
+  const privateKey = env.APPLE_PRIVATE_KEY?.trim().replace(/\\n/g, "\n");
+  if (!teamId || !keyId || !clientId || !privateKey) return null;
+  return { teamId, keyId, clientId, privateKey };
+}
+
+function base64url(value: object | Buffer): string {
+  const buffer = Buffer.isBuffer(value) ? value : Buffer.from(JSON.stringify(value));
+  return buffer.toString("base64url");
+}
+
+/** The client secret Apple's token and revoke endpoints require. */
+export function appleClientSecret(config: AppleConfig, now: number = Date.now()): string {
+  const issuedAt = Math.floor(now / 1000);
+  const header = { alg: "ES256", kid: config.keyId, typ: "JWT" };
+  const payload = {
+    iss: config.teamId,
+    iat: issuedAt,
+    exp: issuedAt + 300,
+    aud: APPLE_AUDIENCE,
+    sub: config.clientId,
+  };
+  const signingInput = `${base64url(header)}.${base64url(payload)}`;
+  const signature = sign("sha256", Buffer.from(signingInput), {
+    key: createPrivateKey(config.privateKey),
+    // JOSE wants the raw r‖s pair, not the DER sequence.
+    dsaEncoding: "ieee-p1363",
+  });
+  return `${signingInput}.${base64url(signature)}`;
+}
+
+type Fetch = typeof fetch;
+
+async function postForm(
+  url: string,
+  fields: Record<string, string>,
+  fetchImpl: Fetch,
+): Promise<Response> {
+  return fetchImpl(url, {
+    method: "POST",
+    headers: { "content-type": "application/x-www-form-urlencoded" },
+    body: new URLSearchParams(fields).toString(),
+  });
+}
+
+/**
+ * Exchange the authorization code from `ASAuthorizationAppleIDCredential` for
+ * a refresh token. The code is single-use and lives five minutes; Supabase's
+ * id-token grant never consumes it, so it is still ours to exchange.
+ */
+export async function exchangeAppleCode(
+  config: AppleConfig,
+  code: string,
+  fetchImpl: Fetch = fetch,
+): Promise<{ refreshToken: string }> {
+  const res = await postForm(
+    APPLE_TOKEN_URL,
+    {
+      client_id: config.clientId,
+      client_secret: appleClientSecret(config),
+      code,
+      grant_type: "authorization_code",
+    },
+    fetchImpl,
+  );
+  const body = (await res.json().catch(() => null)) as {
+    refresh_token?: unknown;
+    error?: unknown;
+  } | null;
+  if (!res.ok || typeof body?.refresh_token !== "string" || !body.refresh_token) {
+    const reason = typeof body?.error === "string" ? body.error : `HTTP ${res.status}`;
+    throw new Error(`apple token exchange failed: ${reason}`);
+  }
+  return { refreshToken: body.refresh_token };
+}
+
+/**
+ * Revoke a refresh token (and every session Apple issued from it). 200 means
+ * revoked; `invalid_grant` means it already was, which is the same outcome.
+ * Anything else throws so the caller can stop before destroying data.
+ */
+export async function revokeAppleToken(
+  config: AppleConfig,
+  refreshToken: string,
+  fetchImpl: Fetch = fetch,
+): Promise<void> {
+  const res = await postForm(
+    APPLE_REVOKE_URL,
+    {
+      client_id: config.clientId,
+      client_secret: appleClientSecret(config),
+      token: refreshToken,
+      token_type_hint: "refresh_token",
+    },
+    fetchImpl,
+  );
+  if (res.ok) return;
+  const body = (await res.json().catch(() => null)) as { error?: unknown } | null;
+  if (res.status === 400 && body?.error === "invalid_grant") return;
+  const reason = typeof body?.error === "string" ? body.error : `HTTP ${res.status}`;
+  throw new Error(`apple token revoke failed: ${reason}`);
+}
