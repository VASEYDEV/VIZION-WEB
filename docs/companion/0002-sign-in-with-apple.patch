+  if (apple?.refresh_token) {
+    const config = appleConfig();
+    if (config) {
+      await revokeAppleToken(config, apple.refresh_token);
+    } else {
+      console.error("[delete-account] APPLE_* not configured — Apple token not revoked");
+    }
+  }
+
   // Media originals: {user_id}/<uuid>.<ext> — paginate the listing so a
   // large library can't strand objects past the first page.
   const mediaStore = admin.storage.from("media");
