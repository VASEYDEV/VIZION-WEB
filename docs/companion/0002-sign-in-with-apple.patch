diff --git a/src/app/api/auth/apple/route.ts b/src/app/api/auth/apple/route.ts
new file mode 100644
index 0000000..6187214
--- /dev/null
+++ b/src/app/api/auth/apple/route.ts
@@ -0,0 +1,82 @@
+import { NextResponse, type NextRequest } from "next/server";
+import { createClient } from "@/lib/supabase/server";
+import { appleConfig, exchangeAppleCode } from "@/lib/auth/apple";
+import { rateLimit } from "@/lib/security/rate-limit";
+
+/**
+ * Sign in with Apple bookkeeping for the native app (vizion-web ADR-0006).
+ *
+ * After the app has signed in — Apple's identity token verified by Supabase,
+ * session in hand — it posts the authorization code from the same credential
+ * here. The server exchanges it for a refresh token and keeps that against
+ * the user, so `DELETE /api/account` can revoke it: Apple requires apps that
+ * offer Sign in with Apple to revoke the user's tokens on account deletion
+ * (App Store Review Guideline 5.1.1(v)). Nothing about the sign-in itself
+ * depends on this call succeeding.
+ *
+ * The row is written with the USER's session (RLS: own row only) — the
+ * service-role client stays confined to deletion.
+ *
+ *   204  stored
+ *   400  no `code` in the JSON body
+ *   401  no verified session
+ *   429  more than five attempts in an hour
+ *   502  Apple rejected the code (expired, reused, wrong client id)
+ *   503  APPLE_* not configured on the server — nothing stored
+ */
+export async function POST(req: NextRequest) {
+  const supabase = await createClient();
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+  if (!user) return NextResponse.json({ error: "Sign in first." }, { status: 401 });
+
+  if (!rateLimit(`apple-code:${user.id}`, 5, 3_600_000).allowed) {
+    return NextResponse.json(
+      { error: "Too many attempts — try again later." },
+      { status: 429 },
+    );
+  }
+
+  const body = (await req.json().catch(() => null)) as { code?: unknown } | null;
+  const code = typeof body?.code === "string" ? body.code.trim() : "";
+  if (!code || code.length > 4096) {
+    return NextResponse.json({ error: "Missing authorization code." }, { status: 400 });
+  }
+
+  const config = appleConfig();
+  if (!config) {
+    console.error(
+      "[api/auth/apple] APPLE_TEAM_ID/KEY_ID/CLIENT_ID/PRIVATE_KEY not configured",
+    );
+    return NextResponse.json(
+      { error: "Sign in with Apple isn't configured on the server yet." },
+      { status: 503 },
+    );
+  }
+
+  let refreshToken: string;
+  try {
+    ({ refreshToken } = await exchangeAppleCode(config, code));
+  } catch (e) {
+    console.error(
+      "[api/auth/apple] exchange failed:",
+      e instanceof Error ? e.message : e,
+    );
+    return NextResponse.json(
+      { error: "Apple did not accept the authorization code." },
+      { status: 502 },
+    );
+  }
+
+  const { error } = await supabase.from("apple_refresh_tokens").upsert({
+    user_id: user.id,
+    refresh_token: refreshToken,
+    updated_at: new Date().toISOString(),
+  });
+  if (error) {
+    console.error("[api/auth/apple] store failed:", error.message);
+    return NextResponse.json({ error: "Couldn't store the token." }, { status: 500 });
+  }
+  return new NextResponse(null, { status: 204 });
+}
