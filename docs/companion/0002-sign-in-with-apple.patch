diff --git a/tests/unit/apple-auth.test.ts b/tests/unit/apple-auth.test.ts
new file mode 100644
index 0000000..c1b39c5
--- /dev/null
+++ b/tests/unit/apple-auth.test.ts
@@ -0,0 +1,139 @@
+import { describe, expect, it, vi } from "vitest";
+import { generateKeyPairSync, verify } from "node:crypto";
+import {
+  appleClientSecret,
+  appleConfig,
+  exchangeAppleCode,
+  revokeAppleToken,
+  type AppleConfig,
+} from "@/lib/auth/apple";
+
+/**
+ * Sign in with Apple server helpers: the ES256 client secret, the code →
+ * refresh-token exchange, and revocation. Apple itself is a fetch stub.
+ */
+const { privateKey, publicKey } = generateKeyPairSync("ec", { namedCurve: "prime256v1" });
+const pem = privateKey.export({ type: "pkcs8", format: "pem" }) as string;
+const config: AppleConfig = {
+  teamId: "TEAM123456",
+  keyId: "KEY1234567",
+  clientId: "ai.vasey.vizion",
+  privateKey: pem,
+};
+
+function decode(segment: string): Record<string, unknown> {
+  return JSON.parse(Buffer.from(segment, "base64url").toString()) as Record<
+    string,
+    unknown
+  >;
+}
+
+function stubFetch(status: number, body: unknown) {
+  return vi.fn<(url: string | URL | Request, init?: RequestInit) => Promise<Response>>(
+    async () =>
+      new Response(body === undefined ? null : JSON.stringify(body), { status }),
+  );
+}
+
+describe("appleConfig", () => {
+  it("is null while any APPLE_* variable is missing", () => {
+    expect(appleConfig({})).toBeNull();
+    expect(
+      appleConfig({ APPLE_TEAM_ID: "T", APPLE_KEY_ID: "K", APPLE_CLIENT_ID: "C" }),
+    ).toBeNull();
+  });
+
+  it("unescapes a \\n-encoded key from the environment", () => {
+    const parsed = appleConfig({
+      APPLE_TEAM_ID: " TEAM123456 ",
+      APPLE_KEY_ID: "KEY1234567",
+      APPLE_CLIENT_ID: "ai.vasey.vizion",
+      APPLE_PRIVATE_KEY: pem.trim().replace(/\n/g, "\\n"),
+    });
+    expect(parsed).toEqual({ ...config, privateKey: pem.trim() });
+  });
+});
+
+describe("appleClientSecret", () => {
+  it("is an ES256 JWT for the team, the app and Apple, signed by the .p8 key", () => {
+    const secret = appleClientSecret(config, 1_800_000_000_000);
+    const [header = "", payload = "", signature = ""] = secret.split(".");
+    expect(decode(header)).toEqual({ alg: "ES256", kid: "KEY1234567", typ: "JWT" });
+    expect(decode(payload)).toEqual({
+      iss: "TEAM123456",
+      sub: "ai.vasey.vizion",
+      aud: "https://appleid.apple.com",
+      iat: 1_800_000_000,
+      exp: 1_800_000_300,
+    });
+    expect(
+      verify(
+        "sha256",
+        Buffer.from(`${header}.${payload}`),
+        { key: publicKey, dsaEncoding: "ieee-p1363" },
+        Buffer.from(signature, "base64url"),
+      ),
+    ).toBe(true);
+  });
+});
+
+describe("exchangeAppleCode", () => {
+  it("posts the code with the client secret and returns the refresh token", async () => {
+    const fetchStub = stubFetch(200, { refresh_token: "r1", id_token: "x" });
+    await expect(
+      exchangeAppleCode(config, "code-1", fetchStub as unknown as typeof fetch),
+    ).resolves.toEqual({ refreshToken: "r1" });
+    const [url, init] = fetchStub.mock.calls[0]!;
+    expect(url).toBe("https://appleid.apple.com/auth/token");
+    const form = new URLSearchParams(init?.body as string);
+    expect(form.get("grant_type")).toBe("authorization_code");
+    expect(form.get("code")).toBe("code-1");
+    expect(form.get("client_id")).toBe("ai.vasey.vizion");
+    expect(form.get("client_secret")?.split(".")).toHaveLength(3);
+  });
+
+  it("throws with Apple's error code when the code is refused", async () => {
+    const fetchStub = stubFetch(400, { error: "invalid_grant" });
+    await expect(
+      exchangeAppleCode(config, "stale", fetchStub as unknown as typeof fetch),
+    ).rejects.toThrow("invalid_grant");
+  });
+
+  it("throws when a 200 carries no refresh token", async () => {
+    const fetchStub = stubFetch(200, { id_token: "only" });
+    await expect(
+      exchangeAppleCode(config, "code-2", fetchStub as unknown as typeof fetch),
+    ).rejects.toThrow("HTTP 200");
+  });
+});
+
+describe("revokeAppleToken", () => {
+  it("resolves on 200 and on an already-invalid token", async () => {
+    await expect(
+      revokeAppleToken(
+        config,
+        "r1",
+        stubFetch(200, undefined) as unknown as typeof fetch,
+      ),
+    ).resolves.toBeUndefined();
+    await expect(
+      revokeAppleToken(
+        config,
+        "r1",
+        stubFetch(400, { error: "invalid_grant" }) as unknown as typeof fetch,
+      ),
+    ).resolves.toBeUndefined();
+  });
+
+  it("sends the refresh-token hint and throws on any other failure", async () => {
+    const fetchStub = stubFetch(500, undefined);
+    await expect(
+      revokeAppleToken(config, "r1", fetchStub as unknown as typeof fetch),
+    ).rejects.toThrow("HTTP 500");
+    const [url, init] = fetchStub.mock.calls[0]!;
+    expect(url).toBe("https://appleid.apple.com/auth/revoke");
+    const form = new URLSearchParams(init?.body as string);
+    expect(form.get("token")).toBe("r1");
+    expect(form.get("token_type_hint")).toBe("refresh_token");
+  });
+});
diff --git a/tests/unit/apple-code-route.test.ts b/tests/unit/apple-code-route.test.ts
new file mode 100644
index 0000000..25a12d7
--- /dev/null
+++ b/tests/unit/apple-code-route.test.ts
@@ -0,0 +1,116 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { NextRequest } from "next/server";
+
+/**
+ * POST /api/auth/apple — the native app hands over Apple's authorization code
+ * after signing in; the server exchanges it and stores the refresh token in
+ * the USER's own row (no service role on this path).
+ */
+const upsertMock = vi.hoisted(() =>
+  vi.fn<(row: Record<string, unknown>) => Promise<{ error: { message: string } | null }>>(
+    async () => ({ error: null }),
+  ),
+);
+const supabaseMock = vi.hoisted(() => ({
+  auth: { getUser: vi.fn(async () => ({ data: { user: { id: "u1" } } })) },
+  from: vi.fn(() => ({ upsert: upsertMock })),
+}));
+vi.mock("@/lib/supabase/server", () => ({
+  createClient: vi.fn(async () => supabaseMock),
+}));
+const appleMock = vi.hoisted(() => ({
+  appleConfig: vi.fn((): unknown => ({
+    teamId: "T",
+    keyId: "K",
+    clientId: "ai.vasey.vizion",
+    privateKey: "pem",
+  })),
+  exchangeAppleCode: vi.fn(async () => ({ refreshToken: "r1" })),
+}));
+vi.mock("@/lib/auth/apple", () => appleMock);
+
+import { POST } from "@/app/api/auth/apple/route";
+
+function request(body: unknown) {
+  return new NextRequest("https://app.test/api/auth/apple", {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+}
+
+/** Distinct ids per case: the route's limiter is keyed per user. */
+function signedInAs(id: string) {
+  supabaseMock.auth.getUser.mockResolvedValue({ data: { user: { id } } });
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.spyOn(console, "error").mockImplementation(() => {});
+  appleMock.appleConfig.mockReturnValue({
+    teamId: "T",
+    keyId: "K",
+    clientId: "ai.vasey.vizion",
+    privateKey: "pem",
+  });
+  appleMock.exchangeAppleCode.mockResolvedValue({ refreshToken: "r1" });
+  upsertMock.mockResolvedValue({ error: null });
+});
+
+describe("POST /api/auth/apple", () => {
+  it("401s without a verified session — before reading the body", async () => {
+    supabaseMock.auth.getUser.mockResolvedValue({ data: { user: null } } as never);
+    const res = await POST(request({ code: "abc" }));
+    expect(res.status).toBe(401);
+    expect(appleMock.exchangeAppleCode).not.toHaveBeenCalled();
+  });
+
+  it("400s without a code (missing, blank, or not JSON)", async () => {
+    signedInAs("u-400");
+    expect((await POST(request({}))).status).toBe(400);
+    expect((await POST(request({ code: "  " }))).status).toBe(400);
+    expect((await POST(request("not json"))).status).toBe(400);
+    expect(appleMock.exchangeAppleCode).not.toHaveBeenCalled();
+  });
+
+  it("503s (nothing stored) while APPLE_* is not configured", async () => {
+    signedInAs("u-503");
+    appleMock.appleConfig.mockReturnValue(null);
+    const res = await POST(request({ code: "abc" }));
+    expect(res.status).toBe(503);
+    expect(upsertMock).not.toHaveBeenCalled();
+  });
+
+  it("exchanges the code and stores the refresh token against the session's user", async () => {
+    signedInAs("u-204");
+    const res = await POST(request({ code: " abc " }));
+    expect(res.status).toBe(204);
+    expect(appleMock.exchangeAppleCode).toHaveBeenCalledWith(
+      expect.objectContaining({ clientId: "ai.vasey.vizion" }),
+      "abc",
+    );
+    expect(supabaseMock.from).toHaveBeenCalledWith("apple_refresh_tokens");
+    expect(upsertMock).toHaveBeenCalledWith(
+      expect.objectContaining({ user_id: "u-204", refresh_token: "r1" }),
+    );
+  });
+
+  it("502s when Apple refuses the code, 500s when the row cannot be written", async () => {
+    signedInAs("u-502");
+    appleMock.exchangeAppleCode.mockRejectedValueOnce(new Error("invalid_grant"));
+    expect((await POST(request({ code: "stale" }))).status).toBe(502);
+    expect(upsertMock).not.toHaveBeenCalled();
+
+    signedInAs("u-500");
+    upsertMock.mockResolvedValueOnce({ error: { message: "boom" } });
+    expect((await POST(request({ code: "abc" }))).status).toBe(500);
+  });
+
+  it("429s after five attempts in an hour", async () => {
+    signedInAs("u-429");
+    for (let i = 0; i < 5; i += 1) {
+      expect((await POST(request({ code: `c${i}` }))).status).toBe(204);
+    }
+    expect((await POST(request({ code: "c5" }))).status).toBe(429);
+  });
+});
