// VIZION — build-time configuration. Copy to Config/Secrets.xcconfig (gitignored)
// and fill in. Values land in Info.plist via $(VAR) substitution and are read by
// AppConfig.swift. NONE of these are secrets in the model-key sense: the anon key
// is public by design (RLS scopes every row), and model keys never leave the
// server (docs/architecture.md). They are still per-environment, so they stay
// out of the tree.
//
// xcconfig treats `//` as a comment, so a URL is written with the `$()` trick:
//   https:/$()/abcdefgh.supabase.co
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// The deployed VIZION web app — its /api/enhance and /api/media routes are the
// model proxy the iOS app talks to (ADR-0002). Preview deploys work too.
VIZION_API_BASE_URL = https:/$()/vizion-io.vercel.app

// Apple Developer Team ID for automatic signing (Xcode → Settings → Accounts).
VIZION_TEAM_ID =
